{
  "schema": 1,
  "name": "reproject",
  "version": "1.0",
  "locality": "local",
  "accepts": {
    "depth": {"accepted": true, "role": "z-buffer visibility"},
    "normals": {"accepted": false},
    "motion": {"accepted": true, "role": "forward pixel reprojection"},
    "ids": {"accepted": false},
    "camera_pose": {"accepted": true, "role": "validated SceneState camera context for motion"},
    "text": {"accepted": false},
    "reference_frames": {"accepted": false}
  },
  "limits": {"max_resolution": [8192, 8192], "max_frames": 10000},
  "color_spaces": ["ACEScg"],
  "returns": {"frames": "OpenEXR RGBA sequence", "honoured": ["depth", "motion", "camera_pose"]}
}

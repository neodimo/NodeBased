        "cyl_radius": 0.12,
        "cyl_height": 0.3,
        "ty": 0.15,
        "cyl_caps": "open",
        "rows": 1,
        "columns": 48,
        "material": "liquid",
        "ior": 1.5,
        "absorption_red": 0.98,
        "absorption_green": 0.99,
        "absorption_blue": 0.99,
        "absorption_distance": 8.0
      }
    },
    {
      "op": "create",
      "id": "$new:glass_base",

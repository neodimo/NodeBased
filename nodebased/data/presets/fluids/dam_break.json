{
  "name": "Dam break",
  "category": "Fluids",
  "description": "A liquid block releases into the basin as a narrow-band FLIP solve.",
  "thumbnail": "dam_break.png",
  "ops": [
    {
      "op": "create",
      "id": "$new:source",
      "type": "FluidSource3D",
      "params": {
        "fluid_type": "liquid",
        "src_center_x": -0.38,
        "src_center_y": 0.72,
        "src_center_z": 0,
        "src_radius": 0.3,
        "src_density": 1.0
      }
    },
    {
      "op": "create",
      "id": "$new:solver",
      "type": "FluidLiquidSolver3D",
      "params": {
        "division_size": 0.25,
        "bounds_min_x": -0.75,
        "bounds_min_y": 0.0,
        "bounds_min_z": -0.75,
        "bounds_max_x": 0.75,
        "bounds_max_y": 1.5,
        "bounds_max_z": 0.75,
        "pressure": "cpu",
        "max_iterations": 80,
        "particles_per_cell": 2,
        "substeps": 1,
        "narrow_band": 2.0
      }
    },
    {
      "op": "connect",
      "id": "$new:solver",
      "input": "fluid",
      "source": "$new:source"
    },
    {
      "op": "create",
      "id": "$new:surface",
      "type": "FluidSurface3D",
      "params": {
        "surface_resolution": 1,
        "smoothing": 1,
        "thin_sheet_preservation": 1
      }
    },
    {
      "op": "connect",
      "id": "$new:surface",
      "input": "particles",
      "source": "$new:solver"
    },
    {
      "op": "create",
      "id": "$new:camera",
      "type": "Camera3D",
      "params": {
        "tz": 4.2,
        "ty": 0.7
      }
    },
    {
      "op": "create",
      "id": "$new:light",
      "type": "Light3D",
      "params": {
        "light_type": "Point",
        "ty": 2.4,
        "tz": 1.8,
        "intensity": 2.0
      }
    },
    {
      "op": "create",
      "id": "$new:scene",
      "type": "Scene3D",
      "params": {}
    },
    {
      "op": "connect",
      "id": "$new:scene",
      "input": "object0",
      "source": "$new:surface"
    },
    {
      "op": "connect",
      "id": "$new:scene",
      "input": "object2",
      "source": "$new:light"
    },
    {
      "op": "create",
      "id": "$new:render",
      "type": "Render3D",
      "params": {
        "width": 64,
        "height": 64,
        "samples": 1
      }
    },
    {
      "op": "connect",
      "id": "$new:render",
      "input": "scene",
      "source": "$new:scene"
    },
    {
      "op": "connect",
      "id": "$new:render",
      "input": "camera",
      "source": "$new:camera"
    }
  ]
}

+class PacingTests(unittest.TestCase):
+    """The frames of a ramp arrive evenly: on the idle clock the RTX's cube takes 16 ms for its first half-size frame and 29 for the next,
+    so the second picture came 60 ms after the first (10/26)."""
+
+    def setUp(self):
+        never_lower(self)
+        self.clock = Clock()
+        self.device = Device()
+        self.state = fake_state(self.device)
+        self.sleeps = []
+        patch = unittest.mock.patch.object(cardclock.time, "sleep", self.sleeps.append)
+        patch.start()
+        self.addCleanup(patch.stop)
+        self.addCleanup(lambda: cardclock._active.__setitem__(0, None))
+
+    def ramp(self):
+        return cardclock.Ramp(1 / 24, clock=self.clock)
+
+    def frame(self, seconds, megabytes=8, step=0.0417):
+        self.clock.now += step
+        cardclock.after_frame(self.state, int(megabytes * 2 ** 20), seconds)
+
+    def reach_up(self, ramp):
+        for _ in range(3):
+            self.frame(0.022)
+        self.clock.now += cardclock.MIN_SECONDS
+        for _ in range(2):
+            self.frame(0.0039)
+        self.assertTrue(ramp.up)
+
+    def begin(self, ramp, seconds_into_render):
+        """A render that began `seconds_into_render` ago."""
+        ramp.frame_began = self.clock.now - seconds_into_render
+
+    def test_a_frame_that_came_back_quickly_is_held_until_it_has_taken_the_paced_share_of_the_frame_time(self):
+        ramp = self.ramp()
+        self.begin(ramp, 0.010)
+        self.sleeps.clear()
+        self.frame(0.008, step=0)
+        self.assertAlmostEqual(self.sleeps[-1], cardclock.PACE_FRACTION / 24 - 0.010, places=6)
+        self.assertGreater(ramp.paced_seconds, 0.010)
+
+    def test_a_frame_that_took_longer_is_not_held(self):
+        ramp = self.ramp()
+        self.begin(ramp, 0.025)
+        self.sleeps.clear()
+        self.frame(0.02, step=0)
+        self.assertEqual(self.sleeps, [])
+
+    def test_the_render_start_is_read_once_per_frame(self):
+        ramp = self.ramp()
+        cardclock.note_frame_start()
+        first = ramp.frame_began
+        self.clock.now += 0.01
+        cardclock.note_frame_start()          # a nested render of the same frame
+        self.assertEqual(ramp.frame_began, first)
+        self.frame(0.01, step=0)
+        self.assertIsNone(ramp.frame_began)    # read by the frame's end
+        self.clock.now += 0.001
+        cardclock.note_frame_start()
+        self.assertEqual(ramp.frame_began, self.clock.now)
+
+    def test_the_start_of_a_cancelled_render_is_not_carried_into_the_next_frame(self):
+        ramp = self.ramp()
+        cardclock.note_frame_start()
+        self.clock.now += 0.2
+        cardclock.note_frame_start()
+        self.assertEqual(ramp.frame_began, self.clock.now)
+
+    def test_a_frame_without_a_known_start_and_the_frames_after_the_switch_are_not_held(self):
+        ramp = self.ramp()
+        self.sleeps.clear()
+        self.frame(0.01, step=0)
+        self.assertEqual(self.sleeps, [])
+        self.reach_up(ramp)
+        self.frame(0.0039)
+        self.frame(0.0039)
+        self.assertTrue(ramp.switch)
+        self.sleeps.clear()
+        cardclock.note_frame_start()
+        self.assertIsNone(ramp.frame_began)
+        self.frame(0.01, step=0)
+        self.assertEqual(self.sleeps, [])
+
+    def test_only_the_last_band_of_a_frame_is_held(self):
+        ramp = self.ramp()
+        self.begin(ramp, 0.01)
+        self.sleeps.clear()
+        cardclock.after_frame(self.state, 8 * 2 ** 20, 0.01, final=False)
+        self.assertEqual(self.sleeps, [])
+        self.assertIsNotNone(ramp.frame_began)
+        cardclock.after_frame(self.state, 8 * 2 ** 20, 0.01, final=True)
+        self.assertEqual(len(self.sleeps), 1)
+
+    def test_the_extra_copy_is_sent_before_the_hold(self):
+        ramp = self.ramp()
+        self.begin(ramp, 0.01)
+        order = []
+        self.device.queue.submit = lambda commands: order.append("copy")
+        with unittest.mock.patch.object(cardclock.time, "sleep", lambda seconds: order.append("hold")):
+            self.frame(0.01, step=0)
+        self.assertEqual(order, ["copy", "hold"])
+
+    def test_no_ramp_no_hold(self):
+        cardclock._active[0] = None
+        self.sleeps.clear()
+        cardclock.note_frame_start()
+        cardclock.after_frame(self.state, 8 * 2 ** 20, 0.01)
+        self.assertEqual(self.sleeps, [])
+

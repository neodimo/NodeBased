-def after_frame(state, readback_bytes, seconds):
-    """Called by a render right after its picture has been read back, `seconds` after it was submitted. While a `Ramp` is running, notes the
-    time and queues a copy to the processor of the bytes the rest of the frame's time can carry at the speed this readback showed
-    (never waited for here: it runs while the frame is on its way to the screen and ends before the next one is submitted)."""
+def note_frame_start():
+    """A frame has just begun (the worker took the request up, or, without one, `gpu3d.render` was entered): the pacing of `after_frame`
+    counts from here. Only the first call of a frame counts (a start older than two frame times belongs to a frame that was cancelled)."""
+    ramp = _active[0]
+    if ramp is None or ramp.switch:
+        return
+    now = ramp.clock()
+    if ramp.frame_began is None or now - ramp.frame_began > 2 * ramp.budget:
+        ramp.frame_began = now
+
+
+def after_frame(state, readback_bytes, seconds, final=True):
+    """Called by a render right after its picture has been read back, `seconds` after it was submitted (`final`: the last band of the
+    frame). While a `Ramp` is running, notes the time and queues a copy to the processor of the bytes the rest of the frame's time can
+    carry at the speed this readback showed (never waited for here: it runs while the frame is on its way to the screen and ends before
+    the next one is submitted), then holds a frame that came back quickly until it has taken PACE_FRACTION of the frame time, so the
+    pictures of the ramp are evenly spaced."""
+    ramp = _active[0]
+    paced = ramp is not None and final and not ramp.switch
+    _after_frame(state, readback_bytes, seconds)
+    if paced:
+        began, ramp.frame_began = ramp.frame_began, None
+        if began is not None:
+            wait = PACE_FRACTION * ramp.budget - (ramp.clock() - began)
+            if wait > 0:
+                ramp.paced_seconds += wait
+                time.sleep(wait)
+
+
+def _after_frame(state, readback_bytes, seconds):
     ramp = _active[0]
     if ramp is None:
         return

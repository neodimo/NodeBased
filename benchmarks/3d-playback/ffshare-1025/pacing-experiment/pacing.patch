+# The frames of a ramp arrive at an even spacing: a frame that came back sooner than the others is held until it has taken PACE_FRACTION of the
+# frame time (measured from the worker picking the request up to the end of the readback, so a scene that takes long to evaluate is held
+# less; the rest of the way to the screen takes 10 ms more). On the idle clock the first half-size frame of the RTX's cube takes 16 ms
+# and the frames after it 29 (26 of them waiting on the card), so the
+# second picture came 60 ms after the first although both frames fit the frame time (10/26); a quarter-size frame (7 ms) between half-size
+# ones did the same. A frame that takes longer than that is not held.
+PACE_FRACTION = 0.50
+
 _active = [None]           # the Ramp of the play that is starting, while its frames are drawn at the lower size
 
 
@@ -104,6 +112,8 @@ class Ramp:
         self.switch = False        # the window draws the chosen size from the next frame on
         self.build_seconds = 0.0   # the longest a frame spent packing and uploading its scene since the ramp began
         self.extra_bytes = 0
+        self.frame_began = None    # when the render in flight started (`note_frame_start`), for the pacing of `after_frame`
+        self.paced_seconds = 0.0   # the time the frames of this ramp were held to even their spacing
         _active[0] = self
 
